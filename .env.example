# ── Reyva Creative Studio ──────────────────────────────────────────────
# Copy to .env on the home server. Only the first block is needed to run.

# Database (docker-compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me
# Host port to publish the app on (reverse proxy → this)
APP_PORT=3000

# AI: article → fields, captions, reel scripts
CS_ANTHROPIC_API_KEY=
# CS_ANTHROPIC_MODEL=
# CS_CAPTION_MODEL=

# Keeps the Settings lock-code cookie valid across restarts (any long random string)
COOKIE_SECRET=
# Code that unlocks the Settings panel on first run (change it there afterwards)
CS_LOCK_CODE=

# ── Optional: sharing buttons light up as each is configured ──
# Telegram channel posting. The bot must be an admin of the channel.
# CS_TELEGRAM_BOT_TOKEN is only needed if a different bot posts there —
# otherwise the desk bot (RELAY_TELEGRAM_BOT_TOKEN) is used.
CS_TELEGRAM_CHANNEL_REYVA=
# CS_TELEGRAM_BOT_TOKEN=
# Telegram article queue (bot webhook) — set both, then CS_SET_WEBHOOK=1 once
# CS_BASE_URL=https://reyva.azmee.dev
# CS_WEBHOOK_SECRET=
# CS_SET_WEBHOOK=1
# X via IFTTT
IFTTT_KEY_REYVA=
# IFTTT_EVENT_REYVA=vxd_tweet_reyva
# Facebook Page (non-expiring Page token)
FB_PAGE_ID_REYVA=
FB_PAGE_TOKEN_REYVA=
# FB_LINK_IN_REYVA=comment   # or caption
# Viber channel
VIBER_TOKEN_REYVA=
VIBER_SENDER_REYVA=

# Postgres over TLS (not needed for the compose db)
# DATABASE_SSL=1

# ── Telegram share desk (relay/) ─────────────────────────────────────────
# New reyvaonline.com stories arrive in a Telegram group as Reyva cards with an
# AI caption and Share buttons for the channels configured above.
RELAY_ENABLED=1
# A NEW bot from @BotFather (not the CS_TELEGRAM_BOT_TOKEN bot)
RELAY_TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back on every webhook call
RELAY_WEBHOOK_SECRET=
# The public address of this app, so Telegram can reach the bot
RELAY_BASE_URL=https://reyva.azmee.dev
# The desk group's chat id (send /id in the group to get it)
RELAY_SHARE_CHAT_REYVA=
# Who may tap: Telegram user ids, comma-separated. Empty = anyone in the group
RELAY_SHARE_APPROVERS_REYVA=
# Optional: minutes between checks (1-30, default 3), and the desk's normal
# card colour (blue by default; 🎨 on each card switches that card to red)
# RELAY_POLL_MINUTES=3
# RELAY_CARD_PALETTE=blue
