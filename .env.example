# ── Reyva Creative Studio ──────────────────────────────────────────────
# Copy to .env on the home server. Only the first block is needed to run.

# Database (docker-compose builds DATABASE_URL from this)
POSTGRES_PASSWORD=change-me
# Host port to publish the app on (reverse proxy → this)
APP_PORT=3000

# AI: article → fields, captions, reel scripts
CS_ANTHROPIC_API_KEY=
# CS_ANTHROPIC_MODEL=
# CS_CAPTION_MODEL=

# Keeps the Settings lock-code cookie valid across restarts (any long random string)
COOKIE_SECRET=
# Code that unlocks the Settings panel on first run (change it there afterwards)
CS_LOCK_CODE=

# ── Optional: sharing buttons light up as each is configured ──
# Telegram channel posting
CS_TELEGRAM_BOT_TOKEN=
CS_TELEGRAM_CHANNEL_REYVA=
# Telegram article queue (bot webhook) — set both, then CS_SET_WEBHOOK=1 once
# CS_BASE_URL=https://reyva.azmee.dev
# CS_WEBHOOK_SECRET=
# CS_SET_WEBHOOK=1
# X via IFTTT
IFTTT_KEY_REYVA=
# IFTTT_EVENT_REYVA=vxd_tweet_reyva
# Facebook Page (non-expiring Page token)
FB_PAGE_ID_REYVA=
FB_PAGE_TOKEN_REYVA=
# FB_LINK_IN_REYVA=comment   # or caption
# Viber channel
VIBER_TOKEN_REYVA=
VIBER_SENDER_REYVA=

# Postgres over TLS (not needed for the compose db)
# DATABASE_SSL=1
